{
  "name": "sigestacionesve-monorepo",
  "version": "0.1.0",
  "description": "Sistema de Gestión de Estaciones de Servicio de Combustibles Venezolanas (SiGEstacionesVE) - Monorepo",
  "author": "Mario Castro <mariocastro.pva@gmail.com>",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} apps/api/prisma/seeder/seed.ts"
  },
  "scripts": {
    "start": "npm run start:dev -w @sigestaciones/api",
    "start:dev": "npm run start:dev -w @sigestaciones/api",
    "start:api": "npm run start:dev -w @sigestaciones/api",
    "start:web": "npm run start -w @sigestaciones/web",
    "init:web": "npm run init:angular -w @sigestaciones/web",
    "build": "npm run build -w @sigestaciones/api",
    "build:all": "npm run build --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "npm run lint -w @sigestaciones/api",
    "test": "npm run test -w @sigestaciones/api",
    "test:cov": "npm run test:cov -w @sigestaciones/api",
    "test:e2e": "npm run test:e2e -w @sigestaciones/api",
    "prisma:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "npx prisma db seed --schema=apps/api/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
    "start:docker-dev": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma && npx prisma db seed --schema=apps/api/prisma/schema.prisma && npm run start:dev -w @sigestaciones/api",
    "start:docker-prod": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma && node apps/api/dist/prisma/seeder/seed.js && node apps/api/dist/src/main"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "rimraf": "^5.0.0"
  }
}
